DATABASE_URL=postgresql://rbc:rbc@localhost:5432/rbc_rms
REDIS_URL=redis://localhost:6379/0

# --- Everything below MUST be set differently per environment. ---
# SECRET_KEY: generate a real one per environment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Never reuse the same key across dev/staging/prod, and never commit a real one.
SECRET_KEY=replace-this-for-local-development
# DEBUG: True only for local dev. False everywhere else — DEBUG=True leaks
# stack traces (settings, SQL, file paths) to anyone who triggers an error.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CORS/CSRF origins: must list the real frontend origin(s) in every
# non-local environment, or every cross-origin request silently fails.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173