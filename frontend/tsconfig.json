{
    "include": [
        "./src/**/*"
    ],
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": ["vite/client"],
        "lib": [
            "ES2020",
            "DOM"
        ],
        "jsx": "react-jsx",
        "noEmit": true
    }
}
